#!/bin/sh
set -e

echo "==> Alma Scanner: postinst starting..."

INSTALL_DIR="/opt/alma-scanner"
VENV_DIR="$INSTALL_DIR/venv"
VENV_PY="$VENV_DIR/bin/python"

echo "==> Alma Scanner: Setting up virtual environment..."
python3 -m venv "$VENV_DIR"

echo "==> Bootstrapping pip inside venv..."
"$VENV_PY" -m ensurepip --default-pip

# Allow pip to install inside this venv even on PEP 668 systems
export PIP_BREAK_SYSTEM_PACKAGES=1

echo "==> Upgrading pip/setuptools/wheel in venv..."
"$VENV_PY" -m pip install --upgrade pip setuptools wheel

echo "==> Installing backend dependencies in venv..."
"$VENV_PY" -m pip install fastapi "uvicorn[standard]" python-magic distro

echo "==> Reloading systemd and enabling service..."
if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload || true
    systemctl enable alma-scanner.service || true
    systemctl restart alma-scanner.service || true
fi

echo "==> Alma Scanner postinst complete."
exit 0
