#!/bin/sh
set -e

INSTALL_DIR="/opt/alma-scanner"
VENV_DIR="$INSTALL_DIR/venv"
VENV_PY="$VENV_DIR/bin/python"

echo "==> Alma Scanner: postinst starting..."
echo "==> Creating virtualenv at $VENV_DIR ..."
python3 -m venv "$VENV_DIR"

echo "==> Bootstrapping pip in venv..."
"$VENV_PY" -m ensurepip --default-pip || true

export PIP_BREAK_SYSTEM_PACKAGES=1

echo "==> Upgrading pip/setuptools/wheel in venv..."
"$VENV_PY" -m pip install --upgrade pip setuptools wheel

echo "==> Installing Python dependencies in venv..."
"$VENV_PY" -m pip install fastapi "uvicorn[standard]" python-magic distro

# systemd reload + enable + start
if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload || true
    systemctl enable alma-scanner.service || true
    systemctl restart alma-scanner.service || true
fi

exit 0
